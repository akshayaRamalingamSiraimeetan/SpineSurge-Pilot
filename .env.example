# ==============================================================================
# SpineSurge Pro Production Build Environment Variables
# ==============================================================================
# DO NOT COMMIT REAL VALUES TO SOURCE CONTROL
# ==============================================================================

# --- macOS Signing & Notarization ---
# Apple ID (usually your email)
APPLE_ID=your-apple-id@example.com
# App-specific password (generated at appleid.apple.com)
APPLE_APP_SPECIFIC_PASSWORD=your-app-specific-password
# Apple Team ID (found in Developer Account membership)
APPLE_TEAM_ID=your-team-id

# --- Windows Signing ---
# Path to P12/PFX certificate file (or base64 string)
CSC_LINK=/path/to/certificate.p12
# Password for the certificate
CSC_KEY_PASSWORD=your-certificate-password

# --- Build Environment ---
# GitHub Token for publishing releases (if using CI)
GH_TOKEN=your-github-personal-access-token

# --- Authentication (Pilot) ---
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# --- Local test login (npm run db:seed-dev-user) ---
DEV_USER_EMAIL=tester@spinesurge.test
DEV_USER_PASSWORD=choose-a-password

# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/spinesurge
# DATABASE_SSL=true|false   (default: on for non-localhost hosts)

# --- Hosting (docs/DEPLOYMENT.md) ---
# SERVE_CLIENT=true          # serve the built web app from the API server (set in Dockerfile)
# UPLOADS_DIR=/data/uploads  # persistent disk for scans/reports
# CORS_ORIGINS=https://example.com   # only needed if the app is served from another origin

# --- Hosted demo ---
# DEMO_MODE=true             # sign-ups skip the email code; allows seeding the demo login
# DEMO_USER_EMAIL=demo@example.com
# DEMO_USER_PASSWORD=change-me
# DEMO_USER_NAME=Demo Surgeon
# VITE_DEMO_EMAIL / VITE_DEMO_PASSWORD   # build-time: pre-fill the sign-in form
