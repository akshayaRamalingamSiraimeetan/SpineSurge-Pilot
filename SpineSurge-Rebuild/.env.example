# SpineSurge Pro — environment template (Step 1)
# Copy to .env and adjust. NEVER commit real secrets. .env is gitignored.

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=spinesurge
POSTGRES_PASSWORD=spinesurge
POSTGRES_DB=spinesurge
POSTGRES_PORT=5432
# Used by the backend (Step 2). Host is 'postgres' inside compose, 'localhost' from host.
DATABASE_URL=postgresql+psycopg://spinesurge:spinesurge@localhost:5432/spinesurge

# ── Redis (jobs/queue) ──────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── MinIO / S3 (reports, non-DICOM images) ─────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=spinesurge
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── Orthanc (DICOMweb) ──────────────────────────────────────────────────────
ORTHANC_USER=spinesurge
ORTHANC_PASSWORD=spinesurge
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
# Backend → Orthanc base URL (DICOMweb root is appended). Host 'orthanc' inside compose.
ORTHANC_URL=http://localhost:8042
ORTHANC_DICOMWEB_ROOT=/dicom-web

# ── Auth / OIDC (fill once provider is chosen, see ADR 0002) ────────────────
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
# Token claim names carrying the active org id / org name / role.
OIDC_ORG_CLAIM=org_id
OIDC_ORG_NAME_CLAIM=org_name
OIDC_ROLE_CLAIM=role

# Local dev auth WITHOUT an external IdP. MUST stay false in production
# (the app refuses to start if APP_ENV=production and this is true).
AUTH_DEV_MODE=true
AUTH_DEV_SECRET=dev-insecure-secret-change-me-0123456789ab

# Comma-separated allowed browser origins (no '*').
CORS_ORIGINS=http://localhost:5173

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
# Frontend (Step 6) reads this:
VITE_API_URL=http://localhost:8000/api/v1
