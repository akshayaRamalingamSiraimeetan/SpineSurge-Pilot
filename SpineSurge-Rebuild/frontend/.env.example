# Backend API base. The FastAPI app serves the v1 contract under /api/v1.
VITE_API_URL=http://localhost:8000/api/v1

# Dev-token identity (local only). The backend mints an HS256 JWT for these when
# auth_dev_mode is on. Production uses OIDC; this flow stays abstracted behind the auth layer.
VITE_DEV_AUTH=true
